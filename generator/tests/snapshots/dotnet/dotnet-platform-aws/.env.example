KAFKA_TOPIC=my-platform-aws-dotnet-client-0025

# Kafka Configuration (Local Confluent Platform)
KAFKA_BOOTSTRAP_SERVERS=localhost:9091

# Schema Registry Configuration (Local Confluent Platform)
SCHEMA_REGISTRY_URL=http://localhost:8081

# AWS KMS Configuration (for field-level encryption)
AWS_KMS_KEY_NAME=my-platform-aws-dotnet-client-0025-kek
AWS_KMS_TYPE=aws-kms
AWS_KMS_KEY_ID=<FILL_ME>

# AWS Credentials
AWS_ACCESS_KEY_ID=<FILL_ME>
AWS_SECRET_ACCESS_KEY=<FILL_ME>

# Consumer Configuration
KAFKA_GROUP_ID=my-platform-aws-dotnet-client-0025-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
