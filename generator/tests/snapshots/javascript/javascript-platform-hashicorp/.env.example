KAFKA_TOPIC=my-platform-hashicorp-js-client-0020

# Kafka Configuration (Local Confluent Platform)
KAFKA_BOOTSTRAP_SERVERS=localhost:9091

# Schema Registry Configuration (Local Confluent Platform)
SCHEMA_REGISTRY_URL=http://localhost:8081

# HashiCorp Vault Configuration (for field-level encryption)
HCVAULT_KMS_KEY_NAME=my-platform-hashicorp-js-client-0020-kek
HCVAULT_KMS_TYPE=hcvault
HCVAULT_KMS_KEY_ID=<FILL_ME>

# Vault Authentication
VAULT_ADDR=<FILL_ME>
VAULT_TOKEN=<FILL_ME>

# Consumer Configuration
KAFKA_GROUP_ID=my-platform-hashicorp-js-client-0020-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
