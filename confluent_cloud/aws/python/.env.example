# Kafka Configuration
KAFKA_TOPIC=csfle-demo
KAFKA_BOOTSTRAP_SERVERS=<BOOTSTRAP_SERVERS_URL>
KAFKA_SASL_USERNAME=<KAFKA_API_KEY>
KAFKA_SASL_PASSWORD=<KAFKA_API_SECRET>

# Schema Registry Configuration
SCHEMA_REGISTRY_URL=<SR_URL>
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=<SR_API_KEY>:<SR_API_SECRET>

# AWS KMS Configuration (Producer)
AWS_KMS_KEY_NAME=<AWS KMS Key Name>
AWS_KMS_TYPE=aws-kms
AWS_KMS_KEY_ID=<AWS KMS Key ARN>

# AWS Credentials
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>

# Consumer Configuration
KAFKA_GROUP_ID=csfle-demo-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
