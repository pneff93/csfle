KAFKA_TOPIC=my-platform-gcp-go-client-0035

# Kafka Configuration (Local Confluent Platform)
KAFKA_BOOTSTRAP_SERVERS=localhost:9091

# Schema Registry Configuration (Local Confluent Platform)
SCHEMA_REGISTRY_URL=http://localhost:8081

# Google Cloud KMS Configuration (for field-level encryption)
GCP_KMS_KEY_NAME=my-platform-gcp-go-client-0035-kek
GCP_KMS_TYPE=gcp-kms
GCP_KMS_KEY_ID=<FILL_ME>

# Google Cloud Service Account fields (extracted from the SA JSON file)
GCP_CLIENT_ID=<FILL_ME>
GCP_CLIENT_EMAIL=<FILL_ME>
GCP_PRIVATE_KEY_ID=<FILL_ME>
# Single-line PEM with literal `\n` escapes; the surrounding double quotes are required so
# godotenv preserves the value as a string. config.go unescapes the `\n` into real newlines
# before passing the key to gcpkms.
GCP_PRIVATE_KEY="<FILL_ME>"

# Consumer Configuration
KAFKA_GROUP_ID=my-platform-gcp-go-client-0035-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
