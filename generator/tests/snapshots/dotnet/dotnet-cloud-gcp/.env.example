KAFKA_TOPIC=my-cloud-gcp-dotnet-client-0031

# Kafka Configuration (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=pkc-example.us-central1.gcp.confluent.cloud:9092
KAFKA_SASL_USERNAME=<FILL_ME>
KAFKA_SASL_PASSWORD=<FILL_ME>

# Schema Registry Configuration (Confluent Cloud)
SCHEMA_REGISTRY_URL=https://psrc-example.us-central1.gcp.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=<FILL_ME>

# Google Cloud KMS Configuration (for field-level encryption)
GCP_KMS_KEY_NAME=my-cloud-gcp-dotnet-client-0031-kek
GCP_KMS_TYPE=gcp-kms
GCP_KMS_KEY_ID=<FILL_ME>

# Google Cloud Service Account fields (extracted from the SA JSON file)
GCP_CLIENT_ID=<FILL_ME>
GCP_CLIENT_EMAIL=<FILL_ME>
GCP_PRIVATE_KEY_ID=<FILL_ME>
# Single-line PEM with literal `\n` escapes; the surrounding double quotes are required so
# DotNetEnv preserves the value as a string. Config.cs unescapes the `\n` into real newlines
# before passing the key to GcpKmsDriver.
GCP_PRIVATE_KEY="<FILL_ME>"

# Consumer Configuration
KAFKA_GROUP_ID=my-cloud-gcp-dotnet-client-0031-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
