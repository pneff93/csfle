{% macro driver_using() -%}
using Confluent.SchemaRegistry.Encryption.Aws;
{%- endmacro %}

{% macro driver_class() -%}
AwsKmsDriver
{%- endmacro %}

{% macro package_reference() -%}
<PackageReference Include="Confluent.SchemaRegistry.Encryption.Aws" Version="{{ confluent_dotnet_version }}" />
{%- endmacro %}

{% macro rule_config_method() -%}
public static Dictionary<string, string> GetAwsRuleConfig()
{
    return new Dictionary<string, string>
    {
        ["rules.access.key.id"] = Get("AWS_ACCESS_KEY_ID"),
        ["rules.secret.access.key"] = Get("AWS_SECRET_ACCESS_KEY"),
    };
}
{%- endmacro %}

{% macro rule_config_method_call() -%}
GetAwsRuleConfig
{%- endmacro %}

{% macro config_validate_keys() -%}
"AWS_KMS_KEY_NAME",
"AWS_KMS_TYPE",
"AWS_KMS_KEY_ID",
"AWS_ACCESS_KEY_ID",
"AWS_SECRET_ACCESS_KEY",
{%- endmacro %}

{% macro env_vars() -%}
# AWS KMS Configuration (for field-level encryption)
AWS_KMS_KEY_NAME={{ kek_name }}
AWS_KMS_TYPE=aws-kms
AWS_KMS_KEY_ID={{ kms_params.kms_key_id or '<FILL_ME>' }}

# AWS Credentials
AWS_ACCESS_KEY_ID={{ kms_params.access_key_id or '<FILL_ME>' }}
AWS_SECRET_ACCESS_KEY={{ kms_params.secret_access_key or '<FILL_ME>' }}
{%- endmacro %}

{% macro kms_type() -%}
aws-kms
{%- endmacro %}

{% macro readme_section() -%}
This client encrypts the `birthday` field using **AWS KMS**. You'll need:

* An **AWS KMS Key** (the KEK). Note the full ARN, e.g. `arn:aws:kms:eu-central-1:123456789:key/xxx-xxx-xxx`.
* An **IAM user or role** with `kms:Encrypt`, `kms:Decrypt`, and `kms:GenerateDataKey` permissions on that key.
* The IAM principal's **Access Key ID** and **Secret Access Key**.

The credentials are passed to `AvroSerializerConfig` / `AvroDeserializerConfig` via `rules.access.key.id` / `rules.secret.access.key` so the `AwsKmsDriver` reads them deterministically (rather than relying on the AWS SDK default credential chain).
{%- endmacro %}
