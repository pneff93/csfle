# Defaults consumed by `csfle-gen new` (wizard prompts) and by `docker compose up`
# in this directory (TAG only). Copy to `.env` and fill in real values.
#
# Angle-bracket placeholders (`<...>`) are filtered out by the wizard, so leaving
# a key with its placeholder value is equivalent to leaving it unset.

# Docker compose
TAG=7.9.4

# Kafka
# Confluent Cloud uses the SASL fields; Confluent Platform leaves them blank.
KAFKA_BOOTSTRAP_SERVERS=<bootstrap servers>
KAFKA_SASL_USERNAME=<api key>

# Schema Registry
SCHEMA_REGISTRY_URL=<sr url>

# AWS KMS
AWS_KMS_KEY_ID=<arn:aws:kms:...>
AWS_ACCESS_KEY_ID=<access key id>
AWS_SECRET_ACCESS_KEY=<secret access key>

# Azure Key Vault
AZURE_KMS_KEY_ID=<https://VAULT.vault.azure.net/keys/KEY/VERSION>
AZURE_TENANT_ID=<tenant id>
AZURE_CLIENT_ID=<client id>
AZURE_CLIENT_SECRET=<client secret>

# GCP KMS
GCP_KMS_KEY_ID=<projects/PROJECT/locations/LOC/keyRings/RING/cryptoKeys/KEY>
GCP_CLIENT_ID=<service account client_id>
GCP_CLIENT_EMAIL=<sa@project.iam.gserviceaccount.com>
GCP_PRIVATE_KEY_ID=<private key id>
GCP_PRIVATE_KEY=<-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n>

# HashiCorp Vault Transit
HCVAULT_KMS_KEY_ID=<http://127.0.0.1:8200/transit/keys/csfle>
VAULT_ADDR=<http://127.0.0.1:8200>
VAULT_TOKEN=<vault token>
