KAFKA_TOPIC=my-cloud-hashicorp-go-client-0040

# Kafka Configuration (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=pkc-example.us-east-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=EXAMPLEKAFKAUSERNAME
KAFKA_SASL_PASSWORD=example-kafka-password

# Schema Registry Configuration (Confluent Cloud)
SCHEMA_REGISTRY_URL=https://psrc-example.us-east-2.aws.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=SREXAMPLEKEY:srexamplesecret

# HashiCorp Vault Configuration (for field-level encryption)
HCVAULT_KMS_KEY_NAME=my-cloud-hashicorp-go-client-0040-kek
HCVAULT_KMS_TYPE=hcvault
HCVAULT_KMS_KEY_ID=http://127.0.0.1:8200/transit/keys/csfle

# Vault Authentication
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=example-vault-token

# Consumer Configuration
KAFKA_GROUP_ID=my-cloud-hashicorp-go-client-0040-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
