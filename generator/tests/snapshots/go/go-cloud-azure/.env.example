KAFKA_TOPIC=my-cloud-azure-go-client-0038

# Kafka Configuration (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=pkc-example.westeurope.azure.confluent.cloud:9092
KAFKA_SASL_USERNAME=<FILL_ME>
KAFKA_SASL_PASSWORD=<FILL_ME>

# Schema Registry Configuration (Confluent Cloud)
SCHEMA_REGISTRY_URL=https://psrc-example.westeurope.azure.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=<FILL_ME>

# Azure Key Vault Configuration (for field-level encryption)
AZURE_KMS_KEY_NAME=my-cloud-azure-go-client-0038-kek
AZURE_KMS_TYPE=azure-kms
AZURE_KMS_KEY_ID=<FILL_ME>

# Azure Service Principal Credentials
AZURE_TENANT_ID=<FILL_ME>
AZURE_CLIENT_ID=<FILL_ME>
AZURE_CLIENT_SECRET=<FILL_ME>

# Consumer Configuration
KAFKA_GROUP_ID=my-cloud-azure-go-client-0038-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
