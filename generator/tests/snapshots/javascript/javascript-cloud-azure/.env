KAFKA_TOPIC=my-cloud-azure-js-client-0022

# Kafka Configuration (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=pkc-example.westeurope.azure.confluent.cloud:9092
KAFKA_SASL_USERNAME=EXAMPLEKAFKAUSERNAME
KAFKA_SASL_PASSWORD=example-kafka-password

# Schema Registry Configuration (Confluent Cloud)
SCHEMA_REGISTRY_URL=https://psrc-example.westeurope.azure.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=SREXAMPLEKEY:srexamplesecret

# Azure Key Vault Configuration (for field-level encryption)
AZURE_KMS_KEY_NAME=my-cloud-azure-js-client-0022-kek
AZURE_KMS_TYPE=azure-kms
AZURE_KMS_KEY_ID=https://example-vault.vault.azure.net/keys/csfle-kek/00000000000000000000000000000000

# Azure Service Principal Credentials
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=11111111-1111-1111-1111-111111111111
AZURE_CLIENT_SECRET=example-client-secret

# Consumer Configuration
KAFKA_GROUP_ID=my-cloud-azure-js-client-0022-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
