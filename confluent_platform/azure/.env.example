# Kafka Configuration (Local Confluent Platform)
KAFKA_TOPIC=csfle-demo
KAFKA_BOOTSTRAP_SERVERS=localhost:9091

# Schema Registry Configuration (Local Confluent Platform)
SCHEMA_REGISTRY_URL=http://localhost:8081

# Azure KMS Configuration (for field-level encryption)
AZURE_KMS_KEY_NAME=csfle-demo-kek
AZURE_KMS_TYPE=azure-kms
AZURE_KMS_KEY_ID=<Azure Key Vault Key Identifier>

# Azure Service Principal Credentials
AZURE_TENANT_ID=<Azure Tenant ID>
AZURE_CLIENT_ID=<Azure Client ID>
AZURE_CLIENT_SECRET=<Azure Client Secret>

# Consumer Configuration
KAFKA_GROUP_ID=csfle-demo-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
