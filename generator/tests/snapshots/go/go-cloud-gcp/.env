KAFKA_TOPIC=my-cloud-gcp-go-client-0039

# Kafka Configuration (Confluent Cloud)
KAFKA_BOOTSTRAP_SERVERS=pkc-example.us-central1.gcp.confluent.cloud:9092
KAFKA_SASL_USERNAME=EXAMPLEKAFKAUSERNAME
KAFKA_SASL_PASSWORD=example-kafka-password

# Schema Registry Configuration (Confluent Cloud)
SCHEMA_REGISTRY_URL=https://psrc-example.us-central1.gcp.confluent.cloud
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=SREXAMPLEKEY:srexamplesecret

# Google Cloud KMS Configuration (for field-level encryption)
GCP_KMS_KEY_NAME=my-cloud-gcp-go-client-0039-kek
GCP_KMS_TYPE=gcp-kms
GCP_KMS_KEY_ID=projects/example/locations/global/keyRings/csfle/cryptoKeys/csfle-kek

# Google Cloud Service Account fields (extracted from the SA JSON file)
GCP_CLIENT_ID=000000000000000000000
GCP_CLIENT_EMAIL=csfle-demo@example.iam.gserviceaccount.com
GCP_PRIVATE_KEY_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Single-line PEM with literal `\n` escapes; the surrounding double quotes are required so
# godotenv preserves the value as a string. config.go unescapes the `\n` into real newlines
# before passing the key to gcpkms.
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEXAMPLEKEYDONOTUSE\n-----END PRIVATE KEY-----\n"

# Consumer Configuration
KAFKA_GROUP_ID=my-cloud-gcp-go-client-0039-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
