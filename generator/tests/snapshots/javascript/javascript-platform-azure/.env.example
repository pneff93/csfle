KAFKA_TOPIC=my-platform-azure-js-client-0018

# Kafka Configuration (Local Confluent Platform)
KAFKA_BOOTSTRAP_SERVERS=localhost:9091

# Schema Registry Configuration (Local Confluent Platform)
SCHEMA_REGISTRY_URL=http://localhost:8081

# Azure Key Vault Configuration (for field-level encryption)
AZURE_KMS_KEY_NAME=my-platform-azure-js-client-0018-kek
AZURE_KMS_TYPE=azure-kms
AZURE_KMS_KEY_ID=<FILL_ME>

# Azure Service Principal Credentials
AZURE_TENANT_ID=<FILL_ME>
AZURE_CLIENT_ID=<FILL_ME>
AZURE_CLIENT_SECRET=<FILL_ME>

# Consumer Configuration
KAFKA_GROUP_ID=my-platform-azure-js-client-0018-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
