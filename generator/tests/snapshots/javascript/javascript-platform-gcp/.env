KAFKA_TOPIC=my-platform-gcp-js-client-0019

# Kafka Configuration (Local Confluent Platform)
KAFKA_BOOTSTRAP_SERVERS=localhost:9091

# Schema Registry Configuration (Local Confluent Platform)
SCHEMA_REGISTRY_URL=http://localhost:8081

# Google Cloud KMS Configuration (for field-level encryption)
GCP_KMS_KEY_NAME=my-platform-gcp-js-client-0019-kek
GCP_KMS_TYPE=gcp-kms
GCP_KMS_KEY_ID=projects/example/locations/global/keyRings/csfle/cryptoKeys/csfle-kek

# Google Cloud Service Account fields (extracted from the SA JSON file)
GCP_CLIENT_ID=000000000000000000000
GCP_CLIENT_EMAIL=csfle-demo@example.iam.gserviceaccount.com
GCP_PRIVATE_KEY_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Single-line PEM with literal `\n` escapes; the surrounding double quotes are required so
# dotenv preserves the value as a string and unescapes the `\n` into real newlines.
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEXAMPLEKEYDONOTUSE\n-----END PRIVATE KEY-----\n"

# Consumer Configuration
KAFKA_GROUP_ID=my-platform-gcp-js-client-0019-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
