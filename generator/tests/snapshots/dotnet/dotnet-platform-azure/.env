KAFKA_TOPIC=my-platform-azure-dotnet-client-0026

# Kafka Configuration (Local Confluent Platform)
KAFKA_BOOTSTRAP_SERVERS=localhost:9091

# Schema Registry Configuration (Local Confluent Platform)
SCHEMA_REGISTRY_URL=http://localhost:8081

# Azure Key Vault Configuration (for field-level encryption)
AZURE_KMS_KEY_NAME=my-platform-azure-dotnet-client-0026-kek
AZURE_KMS_TYPE=azure-kms
AZURE_KMS_KEY_ID=https://example-vault.vault.azure.net/keys/csfle-kek/00000000000000000000000000000000

# Azure Service Principal Credentials
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=11111111-1111-1111-1111-111111111111
AZURE_CLIENT_SECRET=example-client-secret

# Consumer Configuration
KAFKA_GROUP_ID=my-platform-azure-dotnet-client-0026-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest
