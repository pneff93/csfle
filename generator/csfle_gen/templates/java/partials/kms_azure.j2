{% macro dependencies() -%}
<dependency>
    <groupId>io.confluent</groupId>
    <artifactId>kafka-schema-registry-client-encryption-azure</artifactId>
    <version>${confluent.version}</version>
</dependency>
{%- endmacro %}

{% macro executor_params() -%}
// Azure service-principal credentials are passed to the encryption rule
// executor so the AzureKmsDriver can construct a ClientSecretCredential.
props.setProperty("rule.executors._default_.param.tenant.id", Config.getAzureTenantId());
props.setProperty("rule.executors._default_.param.client.id", Config.getAzureClientId());
props.setProperty("rule.executors._default_.param.client.secret", Config.getAzureClientSecret());
{%- endmacro %}

{% macro config_methods() -%}
public static String getAzureKmsKeyId() {
    return getEnvOrThrow("AZURE_KMS_KEY_ID");
}

public static String getAzureKmsKeyName() {
    return getEnvOrThrow("AZURE_KMS_KEY_NAME");
}

public static String getAzureKmsType() {
    return getEnvOrThrow("AZURE_KMS_TYPE");
}

public static String getAzureTenantId() {
    return getEnvOrThrow("AZURE_TENANT_ID");
}

public static String getAzureClientId() {
    return getEnvOrThrow("AZURE_CLIENT_ID");
}

public static String getAzureClientSecret() {
    return getEnvOrThrow("AZURE_CLIENT_SECRET");
}
{%- endmacro %}

{% macro validate_calls() -%}
getAzureKmsKeyId();
getAzureKmsKeyName();
getAzureKmsType();
getAzureTenantId();
getAzureClientId();
getAzureClientSecret();
{%- endmacro %}

{% macro env_vars() -%}
# Azure Key Vault Configuration (for field-level encryption)
AZURE_KMS_KEY_NAME={{ kek_name }}
AZURE_KMS_TYPE=azure-kms
AZURE_KMS_KEY_ID={{ kms_params.kms_key_id or '<FILL_ME>' }}

# Azure Service Principal Credentials
AZURE_TENANT_ID={{ kms_params.tenant_id or '<FILL_ME>' }}
AZURE_CLIENT_ID={{ kms_params.client_id or '<FILL_ME>' }}
AZURE_CLIENT_SECRET={{ kms_params.client_secret or '<FILL_ME>' }}
{%- endmacro %}

{% macro kms_type() -%}
azure-kms
{%- endmacro %}

{% macro readme_section() -%}
This client encrypts the `birthday` field using **Azure Key Vault**. You'll need:

* An **Azure Key Vault** with an **RSA key** (the KEK). The key URL has the form `https://<vault-name>.vault.azure.net/keys/<key-name>/<version>`.
* An **App Registration** (service principal) with `Key Vault Crypto User` role on the vault.
* The service principal's **Tenant ID**, **Client ID**, and **Client Secret**.

The credentials from `.env` are passed to the Schema Registry rule executor so the `AzureKmsDriver` can authenticate.
{%- endmacro %}
